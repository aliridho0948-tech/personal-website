
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Poppins:wght@300;400;600;700&display=swap');

:root {
    --cyan: #00f5ff;
    --purple: #a855f7;
    --bg: #080b18;
    --card: #11182b;
    --text: #f1f5f9;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    background-color: var(--bg);
    background-image:
        linear-gradient(rgba(8,11,24,0.80), rgba(8,11,24,0.90)),
        url('f331ea15f1bad38f496516b4cfc2573b.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    background-repeat: no-repeat;
    color: var(--text);
    font-family: 'Poppins', sans-serif;
    overflow-x: hidden;
}

body::before {
    content: "";
    position: fixed;
    width: 350px;
    height: 350px;
    background: var(--purple);
    filter: blur(150px);
    opacity: .15;
    top: 20%;
    left: -100px;
    z-index: -1;
}

body::after {
    content: "";
    position: fixed;
    width: 350px;
    height: 350px;
    background: var(--cyan);
    filter: blur(150px);
    opacity: .12;
    bottom: 0;
    right: -100px;
    z-index: -1;
}

header {
    position: fixed;
    top: 0;
    width: 100%;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(8,11,24,.85);
    backdrop-filter: blur(15px);
    border-bottom: 1px solid #ffffff15;
    z-index: 100;
}

.logo {
    font-family: 'Orbitron', sans-serif;
    color: var(--cyan);
    font-size: 20px;
}

nav {
    display: flex;
    gap: 25px;
}

nav a {
    color: white;
    text-decoration: none;
    font-size: 13px;
    transition: .3s;
}

nav a:hover {
    color: var(--cyan);
}

section {
    padding: 110px 10%;
    min-height: 100vh;
    scroll-margin-top: 70px;
}

.home {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
}

.tag {
    color: var(--cyan);
    letter-spacing: 3px;
    font-size: 12px;
    margin-bottom: 20px;
}

.home h1 {
    font-size: clamp(38px, 7vw, 75px);
    font-family: 'Orbitron', sans-serif;
    line-height: 1.3;
}

.home h1 span {
    color: var(--cyan);
    text-shadow: 0 0 20px #00f5ff80;
}

.home p {
    color: #aab5ca;
    margin-top: 18px;
    line-height: 1.8;
    max-width: 550px;
}

.btn {
    display: inline-block;
    padding: 13px 28px;
    margin-top: 30px;
    border: 1px solid var(--cyan);
    border-radius: 8px;
    color: var(--cyan);
    text-decoration: none;
    transition: .3s;
}

.btn:hover {
    background: var(--cyan);
    color: var(--bg);
    box-shadow: 0 0 25px #00f5ff80;
}

.section-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 30px;
    margin-bottom: 35px;
}

.section-title span {
    color: var(--cyan);
}

.about-content {
    background: var(--card);
    padding: 35px;
    border: 1px solid #00f5ff35;
    border-radius: 15px;
    line-height: 2;
    color: #bdc8da;
}

.about-content strong {
    color: var(--cyan);
}

.skills {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.skill {
    background: var(--card);
    padding: 25px;
    border-radius: 12px;
    border: 1px solid #ffffff15;
    transition: .3s;
}

.skill:hover {
    transform: translateY(-7px);
    border-color: var(--cyan);
    box-shadow: 0 0 20px #00f5ff20;
}

.skill h3 {
    color: var(--cyan);
    margin-bottom: 10px;
}

.skill p {
    color: #aab5ca;
    font-size: 14px;
}

.contact-card {
    background: var(--card);
    padding: 35px;
    border-radius: 15px;
    border: 1px solid #a855f755;
    text-align: center;
}

footer {
    text-align: center;
    padding: 25px;
    color: #738099;
    border-top: 1px solid #ffffff15;
    font-size: 12px;
}

.reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: .8s;
}

.reveal.show {
    opacity: 1;
    transform: translateY(0);
}

.typing {
    margin-top: 20px;
    color: white;
    font-size: 20px;
}

.typing span {
    color: var(--cyan);
    text-shadow: 0 0 12px var(--cyan);
}

.typing span::after {
    content: "|";
    animation: blink .7s infinite;
}

@keyframes blink {
    50% { opacity: 0; }
}

.profile-frame {
    width: 180px;
    height: 180px;
    padding: 5px;
    border-radius: 50%;
    border: 3px solid var(--cyan);
    box-shadow: 0 0 15px var(--cyan),
                0 0 35px #00f5ff70;
    margin-bottom: 30px;
    animation: float 3s ease-in-out infinite;
}

.profile-frame img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
}

@keyframes float {
    0%, 100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-10px);
    }
}

.social-links {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 25px;
    flex-wrap: wrap;
}

.social-links a {
    display: inline-block;
    color: var(--cyan);
    text-decoration: none;
    border: 1px solid var(--cyan);
    padding: 12px 24px;
    border-radius: 10px;
    transition: 0.3s;
}

.social-links a:hover {
    background: var(--cyan);
    color: var(--bg);
    box-shadow: 0 0 15px var(--cyan);
}

@media(max-width: 600px) {
    header {
        padding: 18px 5%;
        flex-direction: column;
        gap: 15px;
    }

    nav {
        gap: 15px;
    }

    nav a {
        font-size: 11px;
    }

    section {
        padding: 120px 7%;
    }

    .skills {
        grid-template-columns: 1fr;
    }

    .about-content,
    .contact-card {
        padding: 22px;
    }
  }
body {
    background: red !important;
}
